{
    "name": "commercekings/module-core",
    "description": "Shared CommerceKings admin configuration tab and branding for Magento 2.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "CommerceKings"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.4",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceKings\\Core\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/Test/",
            "/.github/",
            "/.gitignore",
            "/.gitattributes"
        ]
    },
    "homepage": "https://github.com/commercekings/module-core",
    "support": {
        "issues": "https://github.com/commercekings/module-core/issues",
        "source": "https://github.com/commercekings/module-core"
    }
}
